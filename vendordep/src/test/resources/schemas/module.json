{
  "type": "object",
  "properties": {
    "drive": {
      "type": "object",
      "description": "Drive motor controller configuration",
      "properties": {
        "type": {
          "enum": [
            "talonfx_krakenx44",
            "talonfx_krakenx60",
            "talonfx_falcon",
            "talonfx_falcon500",
            "talonfxs_neo",
            "talonfxs_neo2",
            "talonfxs_neo550",
            "talonfxs_vortex",
            "talonfxs_pulsar",
            "sparkmax_neo",
            "sparkmax_neo2",
            "sparkmax_neo550",
            "sparkmax_vortex",
            "sparkmax_pulsar",
            "sparkmax_minion",
            "talonfxs_minion",
            "sparkflex_neo",
            "sparkflex_neo2",
            "sparkflex_neo550",
            "sparkflex_vortex",
            "sparkflex_minion",
            "sparkflex_pulsar",
            "nova_neo",
            "nova_neo2",
            "nova_neo550",
            "nova_vortex",
            "nova_minion",
            "nova_pulsar"
          ],
          "type": "string",
          "description": "Controller and motor type"
        },
        "id": {
          "type": "number",
          "description": "CAN ID of the motor controller"
        },
        "canbus": {
          "description": "CAN bus the motor controller is on: \"\" for the Systemcore CAN bus can_s0, \"1\" to \"4\" for can_s1 to can_s4, or \"5\" to \"24\" for the Motioncore CAN buses can_d0 to can_d19, or the CANPort name instead of the number, such as \"CAN_S1\". CTRE devices also take a CANivore's name.",
          "allOf": [
            {
              "$ref": "#/definitions/canbus"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "canbus"
      ]
    },
    "angle": {
      "type": "object",
      "description": "Angle/Steering/Azimuth motor",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "talonfx_krakenx44",
            "talonfx_krakenx60",
            "talonfx_falcon",
            "talonfx_falcon500",
            "talonfxs_neo",
            "talonfxs_neo2",
            "talonfxs_neo550",
            "talonfxs_vortex",
            "talonfxs_pulsar",
            "sparkmax_neo",
            "sparkmax_neo2",
            "sparkmax_neo550",
            "sparkmax_vortex",
            "sparkmax_pulsar",
            "sparkmax_minion",
            "talonfxs_minion",
            "sparkflex_neo",
            "sparkflex_neo2",
            "sparkflex_neo550",
            "sparkflex_vortex",
            "sparkflex_minion",
            "sparkflex_pulsar",
            "nova_neo",
            "nova_neo2",
            "nova_neo550",
            "nova_vortex",
            "nova_minion",
            "nova_pulsar"
          ],
          "description": "Controller and motor for the angle/steering/azimuth"
        },
        "id": {
          "type": "number",
          "description": "CAN ID of the motor controller"
        },
        "canbus": {
          "description": "CAN bus the motor controller is on: \"\" for the Systemcore CAN bus can_s0, \"1\" to \"4\" for can_s1 to can_s4, or \"5\" to \"24\" for the Motioncore CAN buses can_d0 to can_d19, or the CANPort name instead of the number, such as \"CAN_S1\". CTRE devices also take a CANivore's name.",
          "allOf": [
            {
              "$ref": "#/definitions/canbus"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "canbus"
      ]
    },
    "gearing": {
      "type": "object",
      "description": "Gearing of the module. Overrides the gearing from physicalproperties.json if defined.",
      "properties": {
        "drive": {
          "type": "object",
          "description": "Drive motor reduction gearing",
          "properties": {
            "gearRatio": {
              "type": "number",
              "description": "Reduction ratio of the drive motor to the wheel. X where \"X:1\""
            },
            "diameter": {
              "type": "number",
              "description": "Diameter of the wheel in Inches."
            }
          },
          "required": [
            "gearRatio",
            "diameter"
          ]
        },
        "angle": {
          "type": "object",
          "description": "Angle/Steering/Azimuth reduction gearing",
          "properties": {
            "gearRatio": {
              "type": "number",
              "description": "Reduction ratio of the angle/steering/azimuth motor. X where \"X:1\""
            }
          },
          "required": [
            "gearRatio"
          ]
        }
      }
    },
    "absoluteEncoder": {
      "type": "object",
      "description": "Absolute encoder for the swerve module",
      "properties": {
        "type": {
          "enum": [
            "revthroughbore_attached",
            "revthroughbore_dio",
            "splineencoder_can",
            "cancoder_can",
            "canandmag_attached",
            "canandmag_dio",
            "canandmag_can",
            "srxmag_attached",
            "srxmag_analog",
            "andymarkhexbore_attached",
            "andymarkhexbore_dio",
            "andymarkhexbore_analog",
            "andymarkhexbore_can",
            "thrifty_attached",
            "thrifty_analog",
            "analog5v_attached",
            "analog_attached",
            "dutycycle_attached"
          ],
          "type": "string",
          "description": "Type of absolute encoder. _attached encoders are wired to the angle motor controller. thrifty_attached needs a Thrifty Nova angle motor, and a Thrifty Nova does not support analog5v_attached."
        },
        "id": {
          "type": "number",
          "description": "CAN ID of the absolute encoder. Ignored if the absolute encoder is not connected to CAN."
        },
        "channel": {
          "type": "number",
          "description": "AnalogIn Channel the Absolute Encoder is connected to. Ignored if not connected to AnalogIn."
        },
        "canbus": {
          "description": "CAN bus the absolute encoder is on: \"\" for the Systemcore CAN bus can_s0, \"1\" to \"4\" for can_s1 to can_s4, or \"5\" to \"24\" for the Motioncore CAN buses can_d0 to can_d19, or the CANPort name instead of the number, such as \"CAN_S1\". CTRE devices also take a CANivore's name.",
          "allOf": [
            {
              "$ref": "#/definitions/canbus"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "channel",
        "canbus"
      ]
    },
    "inverted": {
      "type": "object",
      "description": "Motor inversions",
      "properties": {
        "drive": {
          "type": "boolean",
          "description": "Drive motor inversion"
        },
        "angle": {
          "type": "boolean",
          "description": "Angle/Steering/Azimuth motor inversion"
        }
      },
      "required": [
        "drive",
        "angle"
      ]
    },
    "absoluteEncoderOffset": {
      "type": "number",
      "description": "Offset of the absolute encoder for the wheel to face forward with the bevel to the left. The units for this are DEGREES"
    },
    "absoluteEncoderInverted": {
      "type": "boolean",
      "description": "Inversion of the absolute encoder"
    },
    "absoluteEncoderGearRatio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "How many times the absolute encoder turns for each turn of the module, X where X:1. An absolute encoder only reads one rotation, so it can't turn more than once per module turn: more than 0, up to 1."
    },
    "location": {
      "type": "object",
      "description": "Location of the module from the center of the robot to the center of the wheel",
      "properties": {
        "front": {
          "type": "number",
          "description": "Front Location of the module from the center of the robot to the center of the wheel in Inches."
        },
        "left": {
          "type": "number",
          "description": "Left location of the module from the center of the robot to the center of the wheel in Inches."
        }
      },
      "required": [
        "left",
        "front"
      ]
    }
  },
  "required": [
    "drive",
    "angle",
    "inverted",
    "absoluteEncoder",
    "absoluteEncoderOffset",
    "location"
  ],
  "allOf": [
    {
      "description": "Only a SPARK MAX, SPARK Flex or Thrifty Nova angle motor controller reads an absolute encoder plugged into it.",
      "if": {
        "properties": {
          "angle": {
            "properties": {
              "type": {
                "not": {
                  "pattern": "^(sparkmax|sparkflex|nova)_"
                }
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "angle"
        ]
      },
      "then": {
        "properties": {
          "absoluteEncoder": {
            "properties": {
              "type": {
                "not": {
                  "pattern": "_attached$"
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "The Thrifty Absolute Encoder only plugs into a Thrifty Nova angle motor controller.",
      "if": {
        "properties": {
          "angle": {
            "properties": {
              "type": {
                "not": {
                  "pattern": "^nova_"
                }
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "angle"
        ]
      },
      "then": {
        "properties": {
          "absoluteEncoder": {
            "properties": {
              "type": {
                "not": {
                  "const": "thrifty_attached"
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "A Thrifty Nova can't read a 5 V analog encoder: use analog_attached.",
      "if": {
        "properties": {
          "angle": {
            "properties": {
              "type": {
                "pattern": "^nova_"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "angle"
        ]
      },
      "then": {
        "properties": {
          "absoluteEncoder": {
            "properties": {
              "type": {
                "not": {
                  "const": "analog5v_attached"
                }
              }
            }
          }
        }
      }
    }
  ],
