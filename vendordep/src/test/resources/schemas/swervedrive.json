{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "gyro": {
      "type": "object",
      "description": "The gyroscope of your robot",
      "properties": {
        "type": {
          "enum": [
            "navx3_can",
            "navx3_usb",
            "pigeon2_can",
            "canandgyro_can",
            "systemcore_internal",
            "custom"
          ],
          "type": "string",
          "description": "The gyroscope type. Use \"custom\" for a gyro YAGSL has no built-in type for; SwerveParser skips creating a gyro device for \"custom\" and expects the SwerveDriveConfig you pass to SwerveParser.createSwerveDrive(...)/createSwerveDriveDevices(...) to already have .withGyro(...) (and optionally .withGyroOffset(...)/.withGyroVelocity(...)) set."
        },
        "id": {
          "type": "number",
          "description": "CAN ID of the Gyroscope. If no CAN ID is needed, set this to 0. Ignored when type is \"custom\"."
        },
        "canbus": {
          "description": "CAN bus the gyroscope is on: \"\" for the Systemcore CAN bus can_s0, \"1\" to \"4\" for can_s1 to can_s4, or \"5\" to \"24\" for the Motioncore CAN buses can_d0 to can_d19, or the CANPort name instead of the number, such as \"CAN_S1\". CTRE devices also take a CANivore's name. Ignored when type is \"custom\".",
          "allOf": [
            {
              "$ref": "#/definitions/canbus"
            }
          ]
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Systemcore USB port of a USB gyroscope (navx3_usb): 0 for USB0 to 3 for USB3. Defaults to 0. Ignored by other gyroscopes."
        }
      },
      "required": [
        "type",
        "id",
        "canbus"
      ]
    },
    "gyroAxis": {
      "type": "string",
      "description": "The axis to use for the robot heading. Default is yaw.",
      "enum": [
        "yaw",
        "pitch",
        "roll"
      ]
    },
    "gyroInvert": {
      "type": "boolean",
      "description": "Invert the gyroscope readings."
    },
    "modules": {
      "type": "array",
      "description": "Swerve module JSON files under the 'modules/' directory.",
      "minItems": 3,
      "items": {
        "pattern": "\\.json$",
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "gyro",
    "gyroInvert",
    "modules"
  ],
  "definitions": {
    "canbus": {
      "type": "string",
      "description": "A Systemcore or Motioncore CAN bus, by number or CANPort name, or a CANivore's name",
      "anyOf": [
